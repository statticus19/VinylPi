[Unit]
Description=Optional vinyl local speaker passthrough
After=sound.target darkice.service

[Service]
Type=simple
# Copy vinyl-passthrough.env.example to this private file and select valid devices first.
EnvironmentFile=/etc/vinyl-passthrough.env
ExecStart=/usr/bin/alsaloop -C ${VINYL_CAPTURE_DEVICE} -P ${VINYL_PLAYBACK_DEVICE} -t 30000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
