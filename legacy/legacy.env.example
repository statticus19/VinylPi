# Historical reference only. Read docs/LEGACY.md before using this script.
ALLOW_LEGACY_VINYL_MASTER=0
# Same Last.fm API credentials described in pi_epaper/orchestrator.env.example.
LASTFM_API_KEY=
LASTFM_API_SECRET=
LASTFM_USERNAME=
LASTFM_PASSWORD_HASH=
# Use the Plex server URL and a token obtained through Plex's account/server tools.
PLEX_URL=http://127.0.0.1:32400
PLEX_TOKEN=
# Use the ratingKey of a specific Plex library track; this is not a tuner ID.
PLEX_TRACK_ID=
# Find the USB capture device with arecord -l; serial port with /dev/ttyACM* listings.
ALSA_DEVICE=
DISPLAY_SERIAL_PORT=/dev/ttyACM0
