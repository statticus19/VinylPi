# Create an API key/secret at https://www.last.fm/api/account/create.
LASTFM_API_KEY=
LASTFM_API_SECRET=
# Use the Last.fm account that should receive vinyl scrobbles.
LASTFM_USERNAME=
# Run ../tools/password_hash.py to obtain a hash without typing a password into history.
LASTFM_PASSWORD_HASH=

# Use your Icecast server root and the exact mount listed on its status page.
ICECAST_URL=http://127.0.0.1:8000
ICECAST_MOUNT=/vinyl
# Tune using the orchestrator's logged sample levels; quieter samples skip recognition.
SILENCE_THRESHOLD_DB=-35

# Copy these values from Icecast's <admin-user> and <admin-password>.
# A blank password disables stream metadata updates.
ICECAST_METADATA_USERNAME=admin
ICECAST_METADATA_PASSWORD=
ICECAST_METADATA_URL=http://127.0.0.1:8000
# 0 shows Artist - Title; 1 appends [Album] when available.
ICECAST_METADATA_INCLUDE_ALBUM=0
