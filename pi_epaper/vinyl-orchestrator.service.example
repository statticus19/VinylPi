[Unit]
Description=Vinyl recognition, Last.fm scrobbles, and Icecast metadata
Wants=network-online.target
After=network-online.target icecast2.service darkice.service

[Service]
Type=simple
# Use the same account/project path as pi-epaper.service so both can read state/.
User=YOUR_PI_USER
WorkingDirectory=/home/YOUR_PI_USER/vinyl-epaper/pi_epaper
EnvironmentFile=/home/YOUR_PI_USER/vinyl-epaper/pi_epaper/orchestrator.env
ExecStart=/home/YOUR_PI_USER/vinyl-epaper/pi_epaper/.venv/bin/python /home/YOUR_PI_USER/vinyl-epaper/pi_epaper/orchestrator_display_ready.py
Restart=on-failure
RestartSec=10
UMask=0077
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
