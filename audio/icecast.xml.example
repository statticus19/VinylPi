<icecast>
    <location>Home</location>
    <!-- Contact email shown by Icecast; the login is authentication/admin-user. -->
    <admin>admin@example.invalid</admin>
    <!-- Set the hostname or LAN address that listeners use. -->
    <hostname>YOUR_PI_HOSTNAME</hostname>
    <limits>
        <clients>10</clients>
        <sources>10</sources>
        <queue-size>524288</queue-size>
        <client-timeout>30</client-timeout>
        <header-timeout>15</header-timeout>
        <source-timeout>10</source-timeout>
        <burst-size>65535</burst-size>
    </limits>
    <!-- Choose your own passwords; use the source password in DarkIce. -->
    <authentication>
        <admin-user>admin</admin-user>
        <source-password>YOUR_SOURCE_PASSWORD</source-password>
        <relay-password>YOUR_RELAY_PASSWORD</relay-password>
        <admin-password>YOUR_ADMIN_PASSWORD</admin-password>
    </authentication>
    <listen-socket>
        <port>8000</port>
        <bind-address>0.0.0.0</bind-address>
    </listen-socket>
    <fileserve>1</fileserve>
    <paths>
        <logdir>/var/log/icecast2</logdir>
        <webroot>/usr/share/icecast2/web</webroot>
        <adminroot>/usr/share/icecast2/admin</adminroot>
        <alias source="/" destination="/status.xsl" />
    </paths>
    <logging>
        <accesslog>access.log</accesslog>
        <errorlog>error.log</errorlog>
        <loglevel>3</loglevel>
    </logging>
</icecast>
