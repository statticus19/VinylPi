[Unit]
Description=ALSA Passthrough Loopback for Behringer UFO202
After=sound.target

[Service]
Type=simple
# Find your USB card ID/device with arecord -l and aplay -l.
# Match DarkIce's shared capture device; replace both YOUR_USB_CARD_ID values.
ExecStart=/usr/bin/alsaloop -C dsnoop:CARD=YOUR_USB_CARD_ID,DEV=0 -P hw:CARD=YOUR_USB_CARD_ID,DEV=0 -t 50000 -r 48000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
