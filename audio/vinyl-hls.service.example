# Set User; create a writable output directory and configure HTTP hosting (docs/PLEX.md).
[Unit]
Description=Vinyl Stream HLS Transcoder for Threadfin/Plex
After=icecast2.service darkice.service

[Service]
Type=simple
User=YOUR_PI_USER
ExecStart=/usr/bin/ffmpeg -hide_banner -loglevel error -f lavfi -i color=c=black:s=640x360:r=5 -i http://127.0.0.1:8000/vinyl -map 0:v -map 1:a -c:v libx264 -preset ultrafast -tune zerolatency -c:a copy -f hls -hls_time 2 -hls_list_size 5 -hls_flags delete_segments /var/www/html/vinyl/index.m3u8
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
