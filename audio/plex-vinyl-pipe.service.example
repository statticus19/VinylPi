# Set User and output path; create/check the optional FIFO first (docs/PLEX.md).
[Unit]
Description=Plex Vinyl Named Pipe Feeder
After=icecast2.service darkice.service

[Service]
Type=simple
User=YOUR_PI_USER
ExecStart=/usr/bin/ffmpeg -re -i http://127.0.0.1:8000/vinyl -c copy -f mp3 -y "/home/YOUR_PI_USER/Music/Vinyl/Vinyl Stream/Vinyl Stream/01 - Vinyl Stream.mp3"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
