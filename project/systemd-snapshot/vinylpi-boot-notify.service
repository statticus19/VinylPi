[Unit]
Description=VinylPi Discord notification after boot
Wants=network-online.target
After=network-online.target tailscaled.service vinylpi-dashboard.service

[Service]
Type=oneshot
User=vinyl
WorkingDirectory=/home/vinyl/music-bridge
EnvironmentFile=/etc/music-bridge-discord-bot.env
ExecStart=/home/vinyl/music-bridge/.venv/bin/python /home/vinyl/music-bridge/scripts/vinylpi_boot_notify.py
RuntimeDirectory=vinylpi-boot-notify
RuntimeDirectoryPreserve=yes
TimeoutStartSec=330
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/vinylpi-boot-notify
PrivateTmp=true

[Install]
WantedBy=multi-user.target
